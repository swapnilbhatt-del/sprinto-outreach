# Copy to .env and fill in. .env is gitignored; never commit real values.
# LLM: config/icp.yaml llm.provider picks which key is used (default: gemini)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
# The ONLY address the pipeline can send to.
OWN_EMAIL=
# OAuth client (Desktop app) JSON from Google Cloud Console, Gmail API enabled, scope gmail.send
GMAIL_CLIENT_SECRET_FILE=client_secret.json
